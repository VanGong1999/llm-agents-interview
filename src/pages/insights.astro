---
import Layout from '../layouts/Layout.astro';import {articles,topics} from '../data/content';import {url} from '../lib/urls';
const insightArticles=articles.filter(a=>a.insight);
---
<Layout title="工程精华" active="insights"><section data-collection data-url-filters><div class="library-tools"><label class="inline-search"><span>⌕</span><input type="search" data-query placeholder="你正在解决什么问题？" aria-label="搜索精华"/></label><select data-topic-select aria-label="精华主题"><option value="all">全部主题</option>{topics.map(t=><option value={t.id}>{t.name}</option>)}</select></div><div class="result-bar"><span><b data-count>{insightArticles.length}</b> 条工程精华</span><span>从详细资料中提取 · 可回溯依据</span></div><div class="insight-grid">{insightArticles.map(a=><article id={a.insight.id} class="insight-card" data-item data-topic={a.topic} data-topic-ids={JSON.stringify(a.topicIds||[a.topic])} data-tags={JSON.stringify(a.tags)} data-search={`${a.insight.title} ${a.insight.problem} ${a.tags.join(' ')}`}><div class="card-meta"><span class="green-tag">{topics.find(t=>t.id===a.topic).name}</span><span>INSIGHT / {a.number}</span></div><h2>{a.insight.title}</h2><p class="insight-problem">{a.insight.problem}</p><div class="insight-action"><span>怎么做</span><p>{a.insight.actions}</p></div><details><summary>查看权衡与验证方法 <span>＋</span></summary><h4>权衡与限制</h4><p>{a.insight.tradeoff}</p><h4>如何验证</h4><p>{a.insight.validation}</p></details><footer><span>工程精华</span><a href={url(`articles/${a.id}/?from=insights#${a.insight.sectionId}`)}>查看详细依据 ↗</a></footer></article>)}</div><div class="empty-state" hidden>目前还没有提取出的工程精华。</div></section></Layout>
