---
import Layout from '../layouts/Layout.astro';
import {topicIndex} from '../lib/taxonomy';
import {url} from '../lib/urls';
---
<Layout title="主题索引" active="topics"><div class="page-intro"><div class="eyebrow">THE ATLAS / 主题索引</div><h1>连接你的知识版图<span class="brand-dot">.</span></h1><p>全部大标签与小标签，一览无余。点击标签查看对应资料，数量按实际标注统计。</p></div><div class="taxonomy-summary"><span><strong>{topicIndex.length}</strong> 个大标签</span><span><strong>{topicIndex.reduce((sum,topic)=>sum+topic.tags.length,0)}</strong> 个小标签</span><span><strong>{topicIndex.reduce((sum,topic)=>sum+topic.count,0)}</strong> 个资料集关联</span></div><section class="topic-grid">{topicIndex.map(topic=><article class="topic-card topic-parent"><a class="topic-card-main" href={url(`library/?topic=${topic.id}`)}><div class="topic-card-top"><span class="topic-heading"><span class="topic-icon">{topic.icon}</span><h2>{topic.name}</h2></span><span class="topic-article-count">{topic.count} 个资料集 ↗</span></div></a><details class="topic-tags-details"><summary class="topic-tags-label"><span>小标签 / {topic.tags.length}</span><span class="topic-expand-hint">展开 <span aria-hidden="true">＋</span></span></summary><div class="taxonomy-tags">{topic.tags.map(tag=><a class:list={['taxonomy-tag',{ 'is-empty':tag.count===0 }]} href={tag.count?url(`library/?topic=${topic.id}&tag=${encodeURIComponent(tag.name)}`):undefined} aria-disabled={tag.count===0?'true':undefined}><span>{tag.name}</span><span class="tag-count">{tag.count}</span></a>)}</div></details></article>)}</section></Layout>
